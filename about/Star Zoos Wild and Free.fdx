<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20250124T200142" id="9c195f5e-0aa0-47bc-81bc-77f1c3655b16">
    <XRef DateTime="20241111T093444" id="9e0f146d-24bb-468f-b15c-821d7a8a2cc9"/>
    <XRef DateTime="20241111T093657" id="e1ad66af-16c4-4ce0-bb95-7ceb67c5936d"/>
    <XRef DateTime="20250102T175442" id="633ebf26-c87d-45b4-9ea4-09ebb1258aaf"/>
  </DocumentRef>

  <Content>
    <Paragraph Type="Scene Heading" id="62ec586b-b404-4f5e-8dcf-83fef884595e">
      <SceneProperties Length="2/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BELKA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Space</Text>
    </Paragraph>
    <Paragraph Type="Action" id="66ab4949-48a4-4ee4-83b2-72b92f1557e7">
      <Text>A field of stars frames the lush, green planet of </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Humedon</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="66ab4949-48a4-4ee4-83b2-72b92f1557e7">
      <Text>The </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Malamotor</Text>
      <Text>, a chrome starship resembling an advanced dogsled, streaks away. Fresh scorch marks mar her hull.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="66ab4949-48a4-4ee4-83b2-72b92f1557e7">
      <Text>The ship approaches a herd of </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Waparays</Text>
      <Text> (colossal space manta rays that dig wormholes for interstellar travel). The ship parks directly beneath a massive ray for cover. As the ship settles, ray bolts from pursuing starfighters strike the herd, disturbing the rays.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="081dcf3b-5cae-4dc3-97b7-e0b93a4d888e">
      <SceneProperties Length="3/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. </Text>
      <Text AdornmentStyle="-1">MalAMotor</Text>
      <Text> - CockPIT - ConTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1b3ff3cb-1edc-4ff3-b6b1-35d0aca4a806">
      <Text AdornmentStyle="-1" Style="AllCaps">Auda</Text>
      <Text Style="AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Waldew</Text>
      <Text> (40s, bruised, aquatic-style helmet) gasps as she pilots. She glances nervously at a </Text>
      <Text Style="AllCaps">bucket</Text>
      <Text> strapped into the passenger seat.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="68b975a2-ff1c-422e-824a-1d0277a01380">
      <Text>She looks up, struggling to keep the ship tucked under the belly of a wiggling </Text>
      <Text AdornmentStyle="-1">Waparay</Text>
      <Text>. Plugged into the dashboard is a triangular, palm-sized </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">zookey</Text>
      <Text> embossed with a fire emblem. She touches the key. The ship roars.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="259a9120-6a40-4a65-922e-db7d52d954cd">
      <Text Style="AllCaps">Pre-lap</Text>
      <Text>: The roar of an angry mob.</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="769b9bdc-cc93-4454-99f7-285ff8563cf3">
      <Text>Match cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="0a2e4d2b-0728-421c-a822-ae717a468839">
      <SceneProperties Length="3/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. Royal Palace, </Text>
      <Text AdornmentStyle="-1">Homedon</Text>
      <Text> - Day (Earlier)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6d571b47-0555-406d-ba9f-8149ddcbe861">
      <Text>A set of </Text>
      <Text AdornmentStyle="-1">ZooKeys</Text>
      <Text> - Fire, Air, and Water - rest in the palm of a dead man’s hand. </Text>
      <Text AdornmentStyle="-1">Auda’s</Text>
      <Text> hand sinks into his. Dressed in elaborate aquatic robes, </Text>
      <Text AdornmentStyle="-1">Auda</Text>
      <Text> weeps.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5fc630e9-917a-4999-a6dc-4a1f587fd320">
      <Text>A </Text>
      <Text Style="AllCaps">torch</Text>
      <Text> shatters a window, igniting the curtains. </Text>
      <Text AdornmentStyle="-1">Auda</Text>
      <Text> grabs the </Text>
      <Text AdornmentStyle="-1">ZooKeys</Text>
      <Text> and pulls a </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Novana</Text>
      <Text> (star-katana) from the dead man’s sheath. She sets down the bucket and slots the </Text>
      <Text AdornmentStyle="-1">ZooKeys</Text>
      <Text> into the sword’s triangular hilt.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d66c32fe-1720-4f25-ae38-91c09bc0c529">
      <Text Style="AllCaps">Thud</Text>
      <Text>. The doors burst open. </Text>
      <Text Style="AllCaps">rioters</Text>
      <Text> flood the chamber.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ff1d03ca-1097-4975-9b98-0459650b783a">
      <Text AdornmentStyle="-1">Auda</Text>
      <Text> clicks the hilt’s dial to the Fire emblem. The blade erupts in flames. She swings.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="62ec586b-b404-4f5e-8dcf-83fef884595e">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BELKA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Space - Present</Text>
    </Paragraph>
    <Paragraph Type="Action" id="99ae543c-248e-4f23-996a-4f6b6614c179">
      <Text>The </Text>
      <Text AdornmentStyle="-1">Malamotor’s</Text>
      <Text> thrusters dim as it approaches the amber moon of </Text>
      <Text Style="AllCaps">Jogi</Text>
      <Text>. The green planet </Text>
      <Text Style="AllCaps">Bering</Text>
      <Text> looms in the distance. The </Text>
      <Text AdornmentStyle="-1">Waparay</Text>
      <Text> detaches from the top of the ship and drifts away.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="081dcf3b-5cae-4dc3-97b7-e0b93a4d888e">
      <SceneProperties Length="2/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AUDA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. </Text>
      <Text AdornmentStyle="-1">MalAMotor</Text>
      <Text> - Quarters - ConTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="08f66db5-3f0b-49f0-9f39-49e6c775ed11">
      <Text AdornmentStyle="-1">Auda</Text>
      <Text> naps in a hammock. </Text>
      <Text Style="AllCaps">Stowaway</Text>
      <Text> </Text>
      <Text Style="AllCaps">rodents</Text>
      <Text> scurry from the shadows. A baby’s cry pierces the silence.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6711ce4c-8b82-4b45-9446-6dd8e7a08be6">
      <Text AdornmentStyle="-1">Auda</Text>
      <Text> bolts to the cockpit. The rodents are peering into the bucket. She shoos them away and cradles her infant son, </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Hiko</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="15c82fac-bb5a-4fd7-b0a9-2dea93b82654">
      <Text AdornmentStyle="-1">Auda</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cb24d6cd-961b-4afc-8dc3-a9b7e84b0b99">
      <Text>Shh... No animal chooses harm, so long as we charm them.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5f755d67-10ba-4b27-9ace-8261cf27d8bc">
      <Text>She lowers him back into his bucket-cradle.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8e01b278-389b-4747-a72d-beb83ef12d40">
      <SceneProperties Length="1/8" Page="2" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Ext. Jogi - Sky - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4b626b77-5ee2-4869-9ed1-f4b5445d1070">
      <Text>The </Text>
      <Text AdornmentStyle="-1">Malamotor</Text>
      <Text> dives into the clouds. As it descends, the ship’s chrome finish fades into a weathered, rusty brown.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="43478d86-99d6-44f9-afa4-4e9d8cfe6864">
      <SceneProperties Length="3/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AUDA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HIKO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. </Text>
      <Text AdornmentStyle="-1">MaLAMOTOR</Text>
      <Text> - COCKPIT - Continuous (12 Years Later)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0cb9b9da-b9f3-4480-8af1-88f0e13a4a9e">
      <Text AdornmentStyle="-1" Style="AllCaps">Hiko</Text>
      <Text> (12, energetic) now wears the bucket on his head.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f01d9baa-e9bd-4d03-bf83-2afbb98741e0">
      <Text AdornmentStyle="-1">AudA</Text>
      <Text> (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e3c0bf0a-b1f6-4caf-a87c-68eeab0ea632">
      <Text>Twelve years and you still haven’t outgrown that thing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="340597a8-3f11-4879-be78-3e17f2759b9e">
      <Text AdornmentStyle="-1">HiKO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7ea1fc85-8249-433d-a685-ed59722ae039">
      <Text>But not the childproof locks!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5f2a44e1-576b-46c7-8f7f-876b5a0b1e15">
      <Text AdornmentStyle="-1">Hiko</Text>
      <Text> slams buttons and yanks a lever.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="429ece7b-95a7-42cf-9c27-053941348126">
      <Text AdornmentStyle="-1">AudA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="57f158b8-2d50-4b8c-a1a2-6f4c4f3d774e">
      <Text AdornmentStyle="-1">Hiko</Text>
      <Text>?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c8f5155f-80f0-47d9-bc77-4cf5d29c62c0">
      <Text AdornmentStyle="-1">Auda</Text>
      <Text> lunges for the controls. The </Text>
      <Text AdornmentStyle="-1">ZooKeys</Text>
      <Text> on the dashboard are now hollow, their emblems gone.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="91106e5a-1ce7-4bda-a2a6-68ddc8333b5e">
      <SceneProperties Length="3/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AUDA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Jogi - SKy - ConTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="73a90d6a-106f-4883-974c-cc3958e2bda7">
      <Text>The ship swerves chaotically, rippling the clouds.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e4a71ffa-9bd4-48cd-b661-05b78c73545e">
      <Text Style="AllCaps">Text appears</Text>
      <Text>: ZOOS </Text>
      <Text AdornmentStyle="-1" Font="Sans Mono CJK Final Draft" Size="10">Я</Text>
      <Text AdornmentStyle="-1">ATZ</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b2c9d7be-3cd4-402c-81cd-1c83e77dacfd">
      <Text AdornmentStyle="-1">AuDA</Text>
      <Text> (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ff3e9bc7-b7b0-494c-b8d8-25c4ae53cc40">
      <Text>You wild animal!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2996857a-f73a-4c7e-9f3c-e29ff8616da5">
      <Text>The ship performs a barrel roll and flips the text into...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6e2b856f-f800-4dbd-a9a8-445d8da21413">
      <Text Style="AllCaps">Title card</Text>
      <Text>: </Text>
      <Text Style="AllCaps">star zoos</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6e2b856f-f800-4dbd-a9a8-445d8da21413">
      <Text Style="AllCaps">Episode: Wild and Free</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="25c7ff29-996f-4917-adc7-31bf0747f06f">
      <Text>Match cut to:</Text>
    </Paragraph>
    <Paragraph Type="New Act" id="3f3e8b28-85c6-4feb-aff7-008d013e5c90">
      <Text Style="Underline+AllCaps">Act One</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="db2b8acb-72c0-431c-972c-e050158f0925">
      <SceneProperties Length="3/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BELKA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MARIUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SHELLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. </Text>
      <Text AdornmentStyle="-1">Amaryis</Text>
      <Text> Star Zoo - </Text>
      <Text AdornmentStyle="-1">Kotteroo</Text>
      <Text> Exhibit - Morning</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5402800d-a165-4c59-817c-7f23b08cdbe4">
      <Text>The water ripples. A </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Kotteroo</Text>
      <Text> (kangaroo otter) breaks the surface, floating on her back with soulful eyes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a1dc4347-45f3-4f2a-a460-6b11fd38d90b">
      <Text>Then the voice of </Text>
      <Text Style="AllCaps">Shelley Dryden</Text>
      <Text> (12, full of life).</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6b49f824-d74e-4e3f-8ea1-b4b44b56f5f1">
      <Text>Shelley (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b557065b-645b-45d7-b708-2807dab689a1">
      <Text>They look so lonely. What are they?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b0248e3e-5a47-4bb5-b235-a547948c148f">
      <Text>MariUS (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2a431feb-fd20-42d7-b47d-5935e38d8122">
      <Text>Let’s answer that once I open our Star Zoo!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="01097577-13ad-4a95-b7ae-00c27e0ccb8f">
      <Text>The </Text>
      <Text AdornmentStyle="-1">Kotteroo</Text>
      <Text> dives back in.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="db2b8acb-72c0-431c-972c-e050158f0925">
      <SceneProperties Length="2/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BELKA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MARIUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Zoo - Entrance - Morning</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ac7ba357-948b-465e-9b0e-946cc55da1db">
      <Text>A massive holographic gate arch scripted in </Text>
      <Text AdornmentStyle="-1">Amaryan</Text>
      <Text> glyphs.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cd972e53-fa0b-42bd-90c0-172880052d08">
      <Text Style="AllCaps">Subtitle</Text>
      <Text>: </Text>
      <Text AdornmentStyle="-1">StarZoo</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">Amaryis</Text>
      <Text>. Operated by </Text>
      <Text AdornmentStyle="-1">Mooncat</Text>
      <Text> Ventures.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="29a4fe01-8afc-4dd3-8011-c6e79f603a23">
      <Text>MarIUS (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c2f47b2a-ee6f-4e81-8a72-b37817c4a343">
      <Text>They ain’t your everyday critters. </Text>
      <Text AdornmentStyle="-1">Kaleidons</Text>
      <Text> are your once-in-an-eon miracles of the Olivo Galaxy.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="db2b8acb-72c0-431c-972c-e050158f0925">
      <SceneProperties Length="1 1/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BELKA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MARIUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RAVEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SHELLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Zoo - Center - Noon</Text>
    </Paragraph>
    <Paragraph Type="Action" id="48dcd8e2-b4bd-42f2-a1ca-81f676a286ab">
      <Text Style="AllCaps">Marius Dryden</Text>
      <Text> (50s, with a wild charismatic beard) stands on a high-tech stage next. Shelley sits beside him, swinging her legs. A massive crowd of humans and multi-eyed aliens cheers.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9c7a175c-fee2-4596-b52c-08a20c513813">
      <Text>MariUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b02d9dcc-52af-4860-abc1-9de094d3278f">
      <Text>Long ago, my daughter Shelley and I lived by scavenging in the </Text>
      <Text AdornmentStyle="-1">Amaryis</Text>
      <Text> underworld. Then, </Text>
      <Text AdornmentStyle="-1">Mooncat</Text>
      <Text> Ventures abduct- I mean- </Text>
      <Text Style="Italic">adopted</Text>
      <Text> us.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0d743baa-0ee2-4424-9ce4-b0d56e9c3809">
      <Text>The crowd chuckles.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="237c48ce-d947-4855-a06f-c16b8fee7bd0">
      <Text>MARIUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6ae89306-93e6-4174-a329-43629cb73c5d">
      <Text>With </Text>
      <Text AdornmentStyle="-1">Mooncat</Text>
      <Text>, we’re adopting and opening </Text>
      <Text AdornmentStyle="-1">Amaryis’s</Text>
      <Text> first </Text>
      <Text AdornmentStyle="-1">StarZoo</Text>
      <Text>, full of </Text>
      <Text AdornmentStyle="-1">Kaleidons</Text>
      <Text>, whose powers help them adapt to any world and harness its element. With </Text>
      <Text AdornmentStyle="-1">ZooKeys</Text>
      <Text>, we can also harness their elements.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bf392a03-0101-4985-ae4b-de55cab41c2f">
      <Text>Marius holds up a triangular, palm-sized </Text>
      <Text AdornmentStyle="-1">ZOOKEY</Text>
      <Text>. A cloud swirls inside the triangle.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f9b39bf0-4742-4221-9234-0981ce595d2c">
      <Text>MarIUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e5f12d7b-545a-4ac2-ab41-512a599c5742">
      <Text>By tagging a </Text>
      <Text AdornmentStyle="-1">Kaleidon</Text>
      <Text>, their cosmic power is in your hands. This clean air you breath here? An air </Text>
      <Text AdornmentStyle="-1">Kaleidon</Text>
      <Text>. Our heating system, best in the planet? Fire </Text>
      <Text AdornmentStyle="-1">Kaleidon</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1d374c0f-d7cf-4423-bf70-0973c3721dd5">
      <Text>He swaps it for a flaming </Text>
      <Text AdornmentStyle="-1">ZooKey</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f37d188e-3d28-4f87-9422-df4945b32e7a">
      <Text>MARIUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5f3ec0ea-49e1-46f6-ae96-ee9cf028d4ba">
      <Text>They are the key to the future!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="efb77a42-ef24-4bc6-9163-745e1682361d">
      <Text>ShELLEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9ec15a41-feac-4c8f-805b-efedeeb14178">
      <Text>And so are you, father!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d5e3faf-312f-4d02-ad32-df054eb4bf92">
      <Text>MarIUS</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="30293b72-15c6-46bf-97a0-c17f10fb741d">
      <Text>(Winks at the crowd)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="93c0b72a-ca22-4cf4-b10b-2d03b51a0748">
      <Text>Careful, Shelley, folks will think I’m only running for Arch-Governor to bring progress. </Text>
      <Text AdornmentStyle="-1">Anywho</Text>
      <Text>, this zoo will bring these powerful </Text>
      <Text AdornmentStyle="-1">Kaleidons</Text>
      <Text> into the picture.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e7ffeffc-f5f3-4d77-ac68-e0564fdb4e4a">
      <Text>Shelley and Marius snip a holographic ribbon with massive plasma scissors. Cameras flash as the crowd applauds.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f645a5cb-ce4f-4592-9642-97f7222e3635">
      <Text>Then, canine howls rip through the air.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="518e4656-5854-4ded-afd6-13ea320bce84">
      <Text>Raven (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="384f9779-6811-4aee-a777-6059231ad908">
      <Text>Not if the Sundogs are in the shot.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="44064ebe-5f75-4bc7-a7ee-397833ccd04f">
      <SceneProperties Length="4/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BELKA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RAVEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SUNDOGS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Zoo - Hidden Tunnel - Afternoon</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5aceaa15-f686-44a4-8ae6-f5ef1bec76cc">
      <Text AdornmentStyle="-1" Style="AllCaps">Jamini</Text>
      <Text> (a child-sized robot with a cassette-tape head), uses an eye-hole to project a hologram of </Text>
      <Text Style="AllCaps">Raven Teachout</Text>
      <Text>. She is a koala-like humanoid with oversized triangular goggles.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fa30b608-06cf-4c35-8835-249f49ecc147">
      <Text>In front of </Text>
      <Text AdornmentStyle="-1">Jamini</Text>
      <Text> stand </Text>
      <Text Style="AllCaps">Belka</Text>
      <Text> and </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Strelka</Text>
      <Text> - seven-foot-tall </Text>
      <Text AdornmentStyle="-1">Terrians</Text>
      <Text> with mixed terrier faces. Wearing flight suits, the sisters are the galaxy’s finest dogfighters, ready to bite.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0dbe5f70-0d91-43e2-941c-a974e6d5da7e">
      <Text>Behind them are other Sundog Movement members of humans, aliens, and robots with a shared goal of liberating animals.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f5df066b-592f-4b52-a76a-4c3689c9b5cb">
      <Text>Raven</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="75ea3cb6-0a3c-437b-8ad0-57fafd9f05a5">
      <Text>Who’ll let these animals out?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5ab793a0-f5e6-460b-8393-821cf526d28d">
      <Text>Sundogs</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d8bf6146-d8e3-42a0-bdfc-1bef105b183b">
      <Text>Sun! Dogs! Dogs! Dogs!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4b5769bc-e2a4-4744-9969-ca1f51ce9125">
      <Text>The Sundogs run out and plant magnetic charges on generators.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="f16a591f-ef0f-4dbe-90c8-99f40e80b7a0">
      <SceneProperties Length="4/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="GATOMATON">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MARIUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. </Text>
      <Text AdornmentStyle="-1">Kotteroo</Text>
      <Text> Exhibit - MomeNTS LATER</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ccfb8416-6178-48b2-9910-4090a65026a8">
      <Text>Shelley presses her nose on the shiny force field. Marius reads a holographic </Text>
      <Text AdornmentStyle="-1">Kotteroo</Text>
      <Text> sign nearby.’</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b16fc498-129e-4314-9712-0bf3edb22e92">
      <Text>MarIUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="21009633-5b7c-44dc-8daa-50b0d32ceb63">
      <Text>Now... to answer your question earlier, they are-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c8368760-de95-484b-b09f-ae97a9785b5f">
      <Text Style="AllCaps">Boom</Text>
      <Text>! </Text>
      <Text Style="AllCaps">Boom</Text>
      <Text>! </Text>
      <Text Style="AllCaps">Boom</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0f6feb7c-f9ce-42ae-ba4b-eda15b3b862c">
      <Text>The ground shakes. All holographic signs flicker and die. Marius spins, eyes wide as plumes of smoke rise and distant force fields dissipate. He turns to a panicked </Text>
      <Text Style="AllCaps">staff</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d2a5199d-4bfe-4baa-b376-5b541ef43ed8">
      <Text>MarIUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9c77fa1a-8a8b-4ed3-a0c5-17599294e882">
      <Text>What are you? Colorblind? Unleash the </Text>
      <Text AdornmentStyle="-1">GatoMatons</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="680606d3-5530-4499-ac17-3151b4217d5b">
      <Text>A sleek robotic cat, the </Text>
      <Text AdornmentStyle="-1">GATOMATON</Text>
      <Text>, leaps onto Marius’s head.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e35d27fd-8f43-43ef-b211-b706f4ed9dab">
      <Text AdornmentStyle="-1">GatoMATON</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="c49512b1-c328-49f7-828c-f5957ce32ffd">
      <Text>(in Spanish; subtitled)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aec8eacf-65b2-42b6-8436-3419cf5028b8">
      <Text>Let’s send them rabid dogs to the Rainbow Road!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="b6970e7c-a88b-4b16-899b-6e3d50a2b4a7">
      <SceneProperties Length="3/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="GATOMATON">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SUNDOG">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Elsewhere - MomentS LATER</Text>
    </Paragraph>
    <Paragraph Type="Action" id="637319a7-209b-4f98-afef-40c8576a615f">
      <Text>A clowder of </Text>
      <Text AdornmentStyle="-1">GatoMatons</Text>
      <Text> swarms from the vents. They launch into the Sundog raiders, tails whipping out electric bolts. The bolts hit the Sundogs who scream, holding intense burns.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="7ee45c63-7ea0-4c99-93c8-00b012c35d13">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="5fb06c4c-c355-46f9-b73e-3407a19bd6ad">
          <Text>Sundog</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="3c6cfadc-712b-4265-89de-1df6a40e30af">
          <Text>Sun set!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="d1bf1a91-6a69-48f4-8c62-c5c05231a0af">
          <Text>SuNDOG</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="bd26fbc0-3413-40ec-a82a-cfedc8acff2c">
          <Text>Dog down!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="4a842a04-b1e0-4255-b500-e39be1c7cc79">
      <Text>Suddenly, shadows lunge out from the smoke. Primal roars drown out the nuts and bolts. Several </Text>
      <Text AdornmentStyle="-1">Kaleidons</Text>
      <Text> (vague, powerful shapes) tear the </Text>
      <Text AdornmentStyle="-1">GatoMatons</Text>
      <Text> into scrap metal.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dbfd1974-6b97-4763-8162-56afd833b9c0">
      <Text AdornmentStyle="-1">GatOMATON</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="26ff584d-5688-4598-b51d-3072f88208a5">
      <Text>(in Spanish; subtitled)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a24e55c0-bc75-4990-81c4-e240bb4362f2">
      <Text>It’s raining Kaleidons...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="b842daea-3e0f-40e5-914c-f90d83000954">
      <SceneProperties Length="1 2/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BELKA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BELKA &amp; STRELKA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MARIUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SHELLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="STRELKA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. </Text>
      <Text AdornmentStyle="-1">Kotteroo</Text>
      <Text> Exhibit - ContinUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="13eb578a-ad39-4f23-947c-7e1d27174d4c">
      <Text>Belka and </Text>
      <Text AdornmentStyle="-1">Strelka</Text>
      <Text> loom over Shelley and Marius.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d04cc5d7-7dab-477a-916a-8f7cfa39d55c">
      <Text>BelkA &amp; </Text>
      <Text AdornmentStyle="-1">STRELKA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="427fd86a-ee6b-4986-87b2-fb749296f03a">
      <Text>We may be colorblind...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="919494c1-a40f-4a9f-ab22-e4d3565c8cbe">
      <Text>BelKA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cad9b83c-e8d2-482a-aac5-3f2d17972ff3">
      <Text>...but we are not blind to...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c775491e-8549-48ff-8b4c-7bccb023bc7f">
      <Text AdornmentStyle="-1">StRELKA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4468b4bd-8621-4c91-be2d-cb23547ee33f">
      <Text>...our feelings getting hurt!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bf735337-9eb6-4452-9338-952e2d74c549">
      <Text>MARIUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="423d22bd-c5a9-446d-95ed-3e62b303a81c">
      <Text>Your body deserves hurting!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="384ba7e7-e9b0-4cd1-825e-b440ee5e40c0">
      <Text>SheLLEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c71367c5-5baf-4753-8dd3-c66362cea999">
      <Text>Starfire!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5583f4c5-3e89-4886-8a54-8fedb0646d3a">
      <Text>Marius whips out his Starfire Snapper Pistol and fires. The sisters weave through the explosive fire bolts with acrobatic grace. The force fields absorb most bolts. One stray bolt hits the </Text>
      <Text AdornmentStyle="-1">Kotteroo’s</Text>
      <Text> generator.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3e9906cf-cc5e-4885-9136-0cabbbdfbf17">
      <Text>The exhibit's force field vanishes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a071bf2b-fa8e-4895-84f0-a9be1097a4e4">
      <Text>BeLKA &amp; </Text>
      <Text AdornmentStyle="-1">STRELKA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b33ca87-fd23-4e27-aa97-65b520e6cf81">
      <Text>Thanks for the assist, star player!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="606b2624-6431-47d4-96ae-2896bbb883b7">
      <Text>The sisters dive into the exhibit.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="606b2624-6431-47d4-96ae-2896bbb883b7">
      <Text Style="AllCaps">Splash</Text>
      <Text>! </Text>
      <Text Style="AllCaps">Splash</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="606b2624-6431-47d4-96ae-2896bbb883b7">
      <Text>The </Text>
      <Text AdornmentStyle="-1">Kotteroo</Text>
      <Text> leaps up and lands on the guest railing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c2c22a2c-8bea-448e-8308-0b528bfecbf3">
      <Text>ShELLEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="00965e08-d5be-4ad7-8165-7b7e863ca15c">
      <Text>Aww...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c0084b80-1b2d-4dba-bdd8-e089843b67af">
      <Text>The </Text>
      <Text AdornmentStyle="-1">Kotteroo</Text>
      <Text> morphs. Her cute smile sharpens into a predatory snarl. She quadruples in size, growing kangaroo muscles.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2e02161f-ede4-4ef2-a6ed-abef9fbd5842">
      <Text>She lunges. Marius throws himself in front of Shelley.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5e45f284-6754-45f0-9a4b-1d460c732bc5">
      <Text>The beast tackles Marius with her fist punching. He screams. His pistol skids across the ground. Shelley grabs it with her shaky hands. She aims, waits for a clear line, and fires.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2cdeeb9c-76f3-4134-84e8-6e5dc2f8e633">
      <Text Style="AllCaps">Thud</Text>
      <Text>. The </Text>
      <Text AdornmentStyle="-1">Kotteroo</Text>
      <Text> collapses, stunned by the fire bolt. She morphs back into a cute otter.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="70b48638-2aba-438c-bdd1-fd421d50fcc5">
      <Text>Shelley drops to her knees, cradling her injured father.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="787b2927-4d67-466a-b33b-77c352ed1971">
      <Text>MarIUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0fe03aa3-d776-4194-a86e-b69a0281e2ef">
      <Text>Hold onto my sunlight...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="25291683-df0e-4d45-9b8b-72a9bc738afe">
      <Text>Marius goes unconscious.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="70b48638-2aba-438c-bdd1-fd421d50fcc5">
      <Text>Above, three ships - two dogfighters and a heavy transport - roar and soar away into the clouds.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="abb98adc-bd43-49d5-865d-8069a12de2a7">
      <Text>Shelley watches them go, with the fire of the burning zoo in her eyes. The wonder is dead. The heat lives on.</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="919d094a-ed61-4634-8845-b3039b35cc05">
      <Text>Match cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c1980797-014d-49d7-aa21-d22d23b691ce">
      <SceneProperties Length="1/8" Page="7" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Ext. Jogi - Amber Fields - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6737cd02-22b3-4c63-962a-05f5b3841a98">
      <Text>A sea of amber wheat ripples. Cutting through the stalks is the rusty </Text>
      <Text AdornmentStyle="-1">Malamotor</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7e72c354-dded-43ed-bfa0-e88adf868130">
      <Text>Steam whistles from a wing’s loose bolt as it accelerates.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c718b121-f1af-45f9-8a51-f3ba334bfc66">
      <SceneProperties Length="1 6/8" Page="7" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AUDA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HIKO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. </Text>
      <Text AdornmentStyle="-1">Malamotor</Text>
      <Text> - Cockpit</Text>
    </Paragraph>
    <Paragraph Type="Action" id="153fbd59-6127-492b-a8fc-15fc45f19f4a">
      <Text AdornmentStyle="-1">Hiko</Text>
      <Text>, with grease-smudged cheeks and wearing a bucket helmet, is pinned to the passenger seat. His bucket snaps off his chin and flies backward.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7822a63c-68ed-449e-92e4-31c50b0f57d9">
      <Text>A hand catches it mid-air. </Text>
      <Text AdornmentStyle="-1">Auda</Text>
      <Text> (now 50s, radiant with a wild spirit) jams the bucket back onto </Text>
      <Text AdornmentStyle="-1">Hiko’s</Text>
      <Text> head without taking her eyes off the horizon.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="30cb5114-5705-46aa-8385-4683144ff977">
      <Text AdornmentStyle="-1">Auda</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2756a676-a600-48b3-b991-214613f6ba74">
      <Text AdornmentStyle="-1">Hiko</Text>
      <Text>! Always wear your bucket.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bda7678f-d3e0-4683-933b-8288775b66ff">
      <Text AdornmentStyle="-1">Hiko</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd129b66-350a-46cc-b466-470fb37fe2e2">
      <Text>If we hit a mountain at Mach 27, how is a hat gonna save us?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eeccfece-ad38-47b6-9436-28bce9a22498">
      <Text AdornmentStyle="-1">AuDA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="deff9246-8c10-49a0-a497-4771d562fa5c">
      <Text>It’s not for the crash, son! If we clip someone’s house, they can’t see our faces. We’re almost home!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="df1b2e6b-d592-4dda-8834-7a37ed37b547">
      <Text AdornmentStyle="-1">Auda</Text>
      <Text> slams the brake petal. The </Text>
      <Text AdornmentStyle="-1">Malamotor’s</Text>
      <Text> engines belch orange smoke, matching the fields below.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8d8a57f2-3fd8-4447-8919-9b739e598320">
      <Text AdornmentStyle="-1">HiKO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5cb1d6b1-264f-4162-9e28-387ea40d270f">
      <Text>Woah. Look!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2055b678-d9f0-44b8-9186-15c4ef791219">
      <Text>High above, a massive </Text>
      <Text Style="AllCaps">Sundog transport </Text>
      <Text>tears through the clouds. </Text>
      <Text AdornmentStyle="-1">Auda</Text>
      <Text> flies by their side.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6013b851-1641-4cad-8c89-a73d69a079fe">
      <Text AdornmentStyle="-1">AuDA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2285f4a0-e55f-4dc5-8c8e-7b67063dad0d">
      <Text>Wave to show that...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d59d8d93-9f0d-4e0c-8285-7aaa193bf4aa">
      <Text AdornmentStyle="-1">HikO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2ebdf035-647d-4d37-8cf2-68929aedba96">
      <Text>...we’re friendlies!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9c0c647d-c3a2-439b-b57a-10ce8746484a">
      <Text AdornmentStyle="-1">Auda</Text>
      <Text> and </Text>
      <Text AdornmentStyle="-1">Hiko</Text>
      <Text> wave. The transport alien pilot waves back. On their helmet is the Sundog crest.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dd9fc80a-d97c-4f5f-b088-cb5faf9c4088">
      <Text AdornmentStyle="-1">HiKO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ef07aed0-8948-4824-a1e6-4c2b79829830">
      <Text>A dog under the star...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="55057bcb-fa70-4979-bcf7-ac97882d5fc0">
      <Text AdornmentStyle="-1">AuDA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fd62045c-0429-48b1-86cd-02212c077762">
      <Text>Ah, a Sundog!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="19864f00-0d4f-4ac8-9560-b9f6aa3d4f51">
      <Text AdornmentStyle="-1">Hiko</Text>
      <Text> looks at </Text>
      <Text AdornmentStyle="-1">Auda</Text>
      <Text>, hoping for an explanation.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f689b475-380e-41d7-b9d9-fb477b8a43fd">
      <Text AdornmentStyle="-1">AudA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2ccb498-62d3-40af-834c-e3992c24848c">
      <Text>Beats me. I don’t got a dog in the fight to know everything in the galaxy, especially when we still got lots to learn about our moon.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d904b2f-a036-4c6c-9d61-06dc8cc3532a">
      <Text AdornmentStyle="-1">HIKO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7e0701e3-5c1a-4700-a012-26f9bf9110fd">
      <Text>I hate Jogi.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="722b4979-53e4-4a25-96a8-1ac877e5add7">
      <Text AdornmentStyle="-1">AuDA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c35d0c57-948f-4c3a-b3fc-4a93b3bbae66">
      <Text>Jogi’s safe.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fd1faa98-8ffe-4090-9f8d-9425a6de9bcd">
      <Text>The starship hits a brief turbulence, rocking the cockpit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="da80b68d-e724-4150-92a6-555954983ae8">
      <Text AdornmentStyle="-1">AuDA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="69cf1b0b-1bd7-4ff9-a846-af08fa354981">
      <Text>Mostly safe. For a moon.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2055b678-d9f0-44b8-9186-15c4ef791219">
      <Text>The transport’s cargo bay yawns open, releasing a menacing flock of winged </Text>
      <Text AdornmentStyle="-1">Kaleidons</Text>
      <Text>. They tumble before catching the wind. The transport ignites its thrusters and vanishes into the clouds.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d35c8838-ac5f-4990-a123-b2b6d13e2eb8">
      <Text AdornmentStyle="-1">HiKO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3882602b-3aff-4126-8443-fa5c50eff9dc">
      <Text>These Sundogs just... dumped a bunch of birds?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5595c576-896a-4a46-8d30-05ee3562bfcf">
      <Text AdornmentStyle="-1">Auda</Text>
      <Text> kicks open the glove box. A dusty </Text>
      <Text Style="AllCaps">holographic encyclopedia</Text>
      <Text> spills out. She tosses it into </Text>
      <Text AdornmentStyle="-1">Hiko’s</Text>
      <Text> lap.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9cad8666-4da0-4459-a91e-7e99db50c1e9">
      <Text AdornmentStyle="-1">AuDA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4dc231e5-2288-4fea-ba36-c35729b3da0c">
      <Text>What sorts of birds?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3223e06e-ef1b-4c06-9a97-1bc487bc6489">
      <Text AdornmentStyle="-1">Hiko</Text>
      <Text> swipes frantically through the glowing pages.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d103c8cb-079b-4c81-bbc5-832fc647f710">
      <Text AdornmentStyle="-1">HiKO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a880c866-52ba-48c7-9add-e7c0e09626a5">
      <Text>They ain’t in the Jogi wildlife log-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a705d9b9-edc5-4ed2-a125-231d877aa2a6">
      <Text AdornmentStyle="-1">AuDA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="baac6439-f3c0-4084-8289-bc96d1b29a7b">
      <Text>Look up </Text>
      <Text AdornmentStyle="-1">StarZoo</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="85539a87-2455-4ff8-87d2-fe4ea4af21c7">
      <Text AdornmentStyle="-1">Hiko</Text>
      <Text> scrolls past local fauna and flora until he comes across the sleek </Text>
      <Text AdornmentStyle="-1">Mooncat</Text>
      <Text> Ventures crest.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9d27d98b-d980-4277-b939-48bf311f02a1">
      <Text AdornmentStyle="-1">HiKO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d5b65359-9bf9-44f7-bdaf-6bc2e7cd1020">
      <Text>Kaleidons?</Text>
    </Paragraph>
  </Content>

